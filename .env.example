# API
APP_NAME=DiffGate
DEBUG=true
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_GITLAB=
# ngrok 等穿透后的 HTTPS 根地址（无尾斜杠），供 UI 展示 Webhook URL
WEBHOOK_PUBLIC_BASE_URL=
# ngrok 控制台 Authtoken（仅本地 .env，勿提交）；配置后 setup_webhook_ngrok.ps1 可自动登录
NGROK_AUTHTOKEN=

# 单人本地：后台分析走 FastAPI BackgroundTasks，只需 uvicorn（默认 true）
USE_BACKGROUND_TASKS=true

# Redis (Celery broker + call-graph cache；USE_BACKGROUND_TASKS=false 且非 eager 时需要)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MySQL
MYSQL_DSN=mysql+pymysql://diffgate:diffgate@localhost:3306/diffgate

# Neo4j (optional; set USE_NEO4J=true to persist call-graph in graph DB)
USE_NEO4J=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=diffgate123

# Local clone root for webhook-triggered analysis
REPO_CLONE_ROOT=./data/repos

# 第四步：精准回归调度中心 Webhook（可选）
# 本地打通探针回传示例：
# DISPATCH_CENTER_URL=http://127.0.0.1:8000/api/v1/dispatch/regression
DISPATCH_CENTER_URL=

# coverage.py / 调度 payload 使用的 API 根地址（无尾斜杠）
API_PUBLIC_BASE_URL=http://127.0.0.1:8000