# 本地无 Docker 推荐配置（复制为 .env）
APP_NAME=DiffGate
DEBUG=true

MYSQL_DSN=sqlite:///data/diffgate.db
USE_REDIS=false
USE_NEO4J=false

CELERY_ALWAYS_EAGER=true
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

REPO_CLONE_ROOT=./data/repos
LOCAL_DATA_DIR=./data

WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_GITLAB=
WEBHOOK_PUBLIC_BASE_URL=
DISPATCH_CENTER_URL=